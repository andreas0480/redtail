# ── Camera ───────────────────────────────────────────────────────────────────
# UniFi Protect RTSP(S) URL for the nest-box camera.
# Use plain RTSPS over TCP — stock ffmpeg cannot handle UniFi SRTP.
RTSP_URL=rtsps://<protect-host>:7441/<stream-token>

# ── Server ────────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8765
TZ=Europe/Stockholm               # Any valid tz name; affects timelapse labels

# ── Storage (SMB / CIFS mount for data volume) ────────────────────────────────
# Leave blank if you use a local bind-mount instead.
SMB_HOST=
SMB_SHARE=
SMB_SUBDIR=

# ── AI analysis ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=                   # Google AI Studio key
GEMINI_MODEL=gemini-2.5-flash     # Flash is fast and cheap enough for this workload

# ── Push notifications (ntfy) ─────────────────────────────────────────────────
NTFY_SERVER=https://ntfy.sh       # Self-hosted ntfy also works
NTFY_TOPIC=                       # Leave blank to disable alerts

# ── Tuning ────────────────────────────────────────────────────────────────────
SNAPSHOT_INTERVAL_SECONDS=300     # One snapshot every 5 min → timelapse frame cadence
BUFFER_SEGMENT_SECONDS=30         # Rolling RTSP buffer segment length
BUFFER_KEEP_SEGMENTS=20           # How many segments to keep (= 10 min pre-roll)
MOTION_SCENE_THRESHOLD=0.02       # Frame-diff threshold to declare motion (0–1)
MOTION_COOLDOWN_SECONDS=120       # Seconds before a new motion clip can be triggered

LOG_LEVEL=INFO

# ── Watch-only mode (post-season) ─────────────────────────────────────────────
# Set to 1 to pause snapshots, motion, recorder, timelapse and daily summary.
# Dashboard stays up; a single Gemini classification runs at noon and pushes an
# ntfy alert on any change from the abandoned/quiet baseline.
WATCH_ONLY=
